# Copia este archivo como .env en la raíz del proyecto (en el VPS) y llena los valores.
# Nunca subas el .env a GitHub.

# Dominio que apunta a la IP del VPS (sin https:// ni www)
DOMINIO=tudominio.com

# Llave de la API de Claude (console.anthropic.com → API Keys)
RETROALIMENTA_CLAUDE_KEY=

# Código de invitación para registrarse como profesor. Mientras el piloto sea
# cerrado, ponle un valor y compártelo solo con los profesores invitados.
# Déjalo vacío para que cualquiera pueda crear cuenta.
REGISTRO_CODIGO=

# Créditos de regalo para cada profesor nuevo (1 crédito = 1 página evaluada)
CREDITOS_INICIALES=50

# Correos con acceso al panel de administración (/admin), separados por comas.
# Cada uno entra con su cuenta de profesor normal (correo y contraseña).
ADMIN_CORREOS=

# Correo de contacto para el plan Escuela en la página de precios (opcional).
CONTACTO_CORREO=

# Avisos de privacidad: correo para derechos ARCO (por omisión privacidad@ieureka-grader.com)
# y domicilio fiscal de la razón social.
PRIVACIDAD_CORREO=
PRIVACIDAD_DOMICILIO=

# Correo para recuperar contraseñas (enlace al correo registrado). Usa un buzón del
# dominio, por ejemplo no-responder@tudominio.com creado en hPanel → Correos.
# Con Hostinger: SMTP_HOST=smtp.hostinger.com y SMTP_PUERTO=465 (SSL/TLS).
# Si se deja vacío, la opción "¿Olvidaste tu contraseña?" avisa que no está configurada.
SMTP_HOST=
SMTP_PUERTO=465
SMTP_USUARIO=
SMTP_CONTRASENA=
# Remitente que ve el usuario (si se deja vacío, se usa SMTP_USUARIO).
CORREO_REMITENTE=

# Pagos de licencias de alumno con Mercado Pago Checkout Pro (Tus integraciones > tu aplicación).
# Sin MP_ACCESS_TOKEN no se puede cobrar. MP_WEBHOOK_SECRET es la clave de la firma del webhook
# (URL del webhook: https://ieureka-grader.com/api/pagos/mercadopago, evento Pagos).
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# 1 = el alumno necesita licencia vigente para ver el curso y entregar. Déjalo vacío hasta probar los pagos.
LICENCIAS_OBLIGATORIAS=
# Solo para demostraciones sin token: permite simular un pago aprobado.
PAGOS_DEMO=
