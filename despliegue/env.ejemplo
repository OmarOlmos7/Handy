# Copia este archivo como .env en la raíz del proyecto (en el VPS) y llena los valores.
# Nunca subas el .env a GitHub.

# Dominio que apunta a la IP del VPS (sin https:// ni www)
DOMINIO=tudominio.com

# Llave de la API de Claude (console.anthropic.com → API Keys)
RETROALIMENTA_CLAUDE_KEY=

# Modelo de Claude (opcional)
CLAUDE_MODEL=claude-opus-5-5

# Código de invitación para registrarse como profesor. Mientras el piloto sea
# cerrado, ponle un valor y compártelo solo con los profesores invitados.
# Déjalo vacío para que cualquiera pueda crear cuenta.
REGISTRO_CODIGO=

# Créditos de regalo para cada profesor nuevo (1 crédito = 1 página evaluada)
CREDITOS_INICIALES=50
