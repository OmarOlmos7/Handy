# Copia este archivo como .env en la raíz del proyecto (en el VPS) y llena los valores.
# Nunca subas el .env a GitHub.

# Dominio o subdominio que apunta a la IP del VPS (sin https://)
DOMINIO=retroalimenta.tudominio.com

# Llave de la API de Claude (console.anthropic.com → API Keys)
RETROALIMENTA_CLAUDE_KEY=

# Modelo de Claude (opcional)
CLAUDE_MODEL=claude-opus-5-5

# Usuario y contraseña que pide el sitio mientras no hay inicio de sesión real.
# El hash se genera con:  docker run --rm caddy:2.10 caddy hash-password --plaintext 'TU-CONTRASEÑA'
# Escríbelo entre comillas simples porque contiene signos $.
ACCESO_USUARIO=profesor
ACCESO_HASH=''
